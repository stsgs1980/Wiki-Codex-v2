# =============================================================================
# Wiki Codex — Environment Variables Template
# =============================================================================
# Copy this file to .env and adjust values:
#   cp .env.example .env
# =============================================================================

# Database connection string (REQUIRED).
#
# Default provider in prisma/schema.prisma is SQLite — best for local dev.
#   SQLite:  file:./db/custom.db
#            (the path is resolved relative to the project root)
#
# To switch to PostgreSQL (recommended for production / multi-instance):
#   1. Edit prisma/schema.prisma:  provider = "postgresql"
#   2. Run:  bun run db:push
#   3. Set DATABASE_URL to your Neon / Supabase / Render connection string, e.g.
#      postgresql://postgres:postgres@localhost:5432/wiki_codex
DATABASE_URL=file:./db/custom.db

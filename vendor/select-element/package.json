{
  "name": "@zai/select-element",
  "version": "1.1.0",
  "description": "Drop-in DOM element selection for React/Next.js. Draggable FAB button with midnight theme, simplified dialog with syntax highlighting, smart element detection, keyboard navigation, i18n (EN/RU). Zero config, fully typed.",
  "main": "index.ts",
  "module": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "require": "./index.ts",
      "types": "./index.ts"
    }
  },
  "files": [
    "*.ts",
    "*.tsx",
    "README.md",
    "CHANGELOG.md",
    "VERSION"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"const fs=require('fs'); const v=require('./package.json').version; fs.writeFileSync('VERSION', v+'\\n')\""
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "select-element",
    "element-picker",
    "devtools",
    "fab-button",
    "floating-action-button",
    "draggable",
    "midnight-theme",
    "react-hook",
    "nextjs",
    "catppuccin",
    "dom-selector",
    "hover-highlight",
    "react",
    "typescript",
    "syntax-highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stsgs1980/SelectElement.git"
  },
  "homepage": "https://github.com/stsgs1980/SelectElement#readme",
  "bugs": {
    "url": "https://github.com/stsgs1980/SelectElement/issues"
  },
  "license": "MIT",
  "author": "stsgs1980",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
